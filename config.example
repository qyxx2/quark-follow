# ==============================
# Quark
# ==============================

# 完整 Cookie。不要把 Cookie 写进 tasks。
QUARK_COOKIE='replace-with-your-quark-cookie'
# Quark API 请求之间的最小间隔；多任务同时运行时也是全局限制。
QUARK_API_DELAY=2

# 转存任务查询间隔
QUARK_TASK_POLL=8

# 单个转存任务最长等待时间
QUARK_TASK_TIMEOUT=7200


# ==============================
# OpenList
# ==============================

# 不要带最后的 /
OPENLIST_URL='http://openlist-host:5244'

# OpenList API Token
OPENLIST_TOKEN='replace-with-your-openlist-token'

# 如果 target 本身没有设置密码，就留空
OPENLIST_PASSWORD=''


# ==============================
# WebDAV
# ==============================

# OpenList WebDAV 地址，例如：https://example.com/dav
WEBDAV_URL='http://openlist-host:5244/dav'
WEBDAV_USER='replace-with-your-webdav-user'
WEBDAV_PASS='replace-with-your-webdav-password'


# ==============================
# 并行任务
# ==============================

# 同时处理几个不同剧集
MAX_PARALLEL_TASKS=2


# ==============================
# 媒体过滤
# ==============================

# 小于这个大小的视频默认认为异常
VIDEO_MIN_MB=100

# 大于这个大小的视频默认认为异常；0 = 不限制
VIDEO_MAX_GB=40

# 大于这个大小的压缩包写入日志
ARCHIVE_LOG_MB=500


# ==============================
# OpenList 刷新
# ==============================

# 转存完成后等待几秒再刷新
OPENLIST_REFRESH_WAIT=3

# 刷新后如果没看到文件，最多重复刷新几次
OPENLIST_REFRESH_RETRY=5

# 每次刷新之间等待
OPENLIST_REFRESH_INTERVAL=3


# ==============================
# 安全
# ==============================

# 如果群晖 OpenSSL 需要 TLS 1.2，默认限制最高 TLS 1.2。
# 环境不需要限制时可改为：CURL_TLS_MAX=''
CURL_TLS_MAX='1.2'

# true = 只扫描，不实际转存
DRY_RUN=false

# 未为资源设置 directory 时使用的 WebDAV 根目录
WEBDAV_DEFAULT_ROOT='/kuake/其他'

RESOURCE_AUTO_ADD=true
RESOURCE_AUTO_DISCOVER=true
RESOURCE_RECHECK_EXISTING_MAX=3
RESOURCE_RECHECK_HOURS=24
RESOURCE_SEEDHUB_ROUNDS=3
RESOURCE_TASK_MAX=3

REPLACE_SOURCE_CHECK_MAX=5
REPLACE_MIN_RATIO=1.30
REPLACE_MIN_GAIN_MB=500
REPLACE_ENABLED=true
REPLACE_WINDOW_START_HOUR=2
REPLACE_WINDOW_END_HOUR=7

# 留空以使用脚本目录下的 logs；也可以设为绝对路径。
LOG_DIR=''

# 执行 WebDAV 文件同步结果检查的最长等待时间和检查间隔时间
RESOURCE_ADD_VERIFY_TIMEOUT=200
RESOURCE_ADD_VERIFY_INTERVAL=10
